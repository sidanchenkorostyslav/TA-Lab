#include <stdio.h>
#define V 8
#define INF 999

int graph[V][V] = {
 {0,8,2,4,3,0,0,0}, {8,0,0,0,6,3,0,0},
 {2,0,0,6,0,7,0,4}, {4,0,6,0,1,0,0,0},
 {3,6,0,1,0,0,4,0}, {0,3,7,0,0,0,3,1},
 {0,0,0,0,4,3,0,5}, {0,0,4,0,0,1,5,0}
};

void prim(void) {
    int used[V] = {0};
    int edges = 0, total = 0;
    used[0] = 1;                

    while (edges < V - 1) {
        int best = INF, from = -1, to = -1;
        for (int i = 0; i < V; ++i)
            if (used[i])
                for (int j = 0; j < V; ++j)
                    if (!used[j] && graph[i][j] > 0 && graph[i][j] < best) {
                        best = graph[i][j]; from = i; to = j;
                    }
        used[to] = 1;
        printf("%d - %d : %d\n", from + 1, to + 1, best);
        total += best; ++edges;
    }
    printf("Вага MST = %d\n", total);
}

int main(void) { prim(); return 0; }
