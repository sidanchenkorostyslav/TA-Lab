#include <stdio.h>
#define V 8
#define E 14

typedef struct { int u, v, w; } Edge;
Edge edges[E] = {
 {4,5,1},{6,8,1},{1,3,2},{1,5,3},{2,6,3},{6,7,3},
 {3,8,4},{1,4,4},{5,7,4},{7,8,5},{2,5,6},{3,4,6},
 {3,6,7},{1,2,8}
};
int parent[V + 1];
int find(int x) { while (parent[x] != x) x = parent[x]; return x; }
void unite(int a, int b) { parent[find(a)] = find(b); }
void sort_edges(void) {
    for (int i = 0; i < E - 1; ++i)
        for (int j = i + 1; j < E; ++j)
            if (edges[j].w < edges[i].w) {
                Edge t = edges[i]; edges[i] = edges[j]; edges[j] = t;
            }
}
void kruskal(void) {
    for (int i = 1; i <= V; ++i) parent[i] = i;
    sort_edges(); int count = 0, total = 0;
    for (int i = 0; i < E && count < V - 1; ++i)
        if (find(edges[i].u) != find(edges[i].v)) {
            printf("%d - %d : %d\n", edges[i].u, edges[i].v, edges[i].w);
            total += edges[i].w; ++count;
            unite(edges[i].u, edges[i].v);
        }
    printf("Вага MST = %d\n", total);
}
int main(void) { kruskal(); return 0; }
